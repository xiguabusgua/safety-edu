# ====== safety-edu Docker 环境变量 ======
# 复制本文件为 .env 并填写配置
#
#   cp .env.example.docker .env
#   docker compose up -d
# ===========================================

# ----- 数据库 -----
# MySQL root 密码 (首次启动时创建)
MYSQL_ROOT_PASSWORD=changeme_root_password
# MySQL lens_light 用户密码
MYSQL_PASSWORD=changeme_lens_light

# ----- 安全密钥 -----
# AES-256 密钥 (openssl rand -hex 32 生成, 必须 64 hex 字符)
ACCOUNT_ENC_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# Cookie 签名密钥 (至少 32 字符)
COOKIE_SECRET="replace-with-random-string-at-least-32-chars-long"
# JWT 签名密钥 (至少 32 字符)
JWT_SECRET="replace-with-random-string-at-least-32-chars-long"

# ----- CORS / 公开 URL -----
# 允许的前端来源, 多个用逗号分隔
CORS_ORIGIN="https://safety.example.com"
# 公开基础 URL (用于支付回调等)
PUBLIC_BASE_URL="https://safety.example.com"

# ----- Runner -----
# Python worker 并发数
RUNNER_CONCURRENCY=2

# ----- 支付模式 -----
# mock = 模拟支付 (不上线微信就用这个)
# real = 微信支付 V3 (需配置下方 WeChat Pay 参数)
PAY_MODE=mock

# ----- 微信支付 V3 (可选, PAY_MODE=mock 时留空) -----
# WECHAT_PAY_MCHID=
# WECHAT_PAY_APPID=
# WECHAT_PAY_SERIAL_NO=
# WECHAT_PAY_PRIVATE_KEY=
# WECHAT_PAY_NOTIFY_URL=
# WECHAT_PAY_API_V3_KEY=
