# ====== 数据库 ======
DATABASE_URL="mysql://lens_light:YOUR_PASSWORD@127.0.0.1:3306/lens_light"

# ====== 服务端口 ======
PORT=3002
NODE_ENV=production

# ====== 安全密钥 (openssl rand -hex 32 生成) ======
ACCOUNT_ENC_KEY="REPLACE_WITH_HEX_64_CHARS"
COOKIE_SECRET="REPLACE_WITH_RANDOM_AT_LEAST_32_CHARS"
JWT_SECRET="REPLACE_WITH_RANDOM_AT_LEAST_32_CHARS"

# ====== CORS ======
CORS_ORIGIN="https://safety.52akuya.asia"

# ====== 公开基础 URL ======
PUBLIC_BASE_URL="https://safety.52akuya.asia"

# ====== Runner 进程 ======
RUNNER_CONCURRENCY=2

# ====== 微信支付 V3 (不上线则留空走 mock) ======
PAY_MODE=mock
WECHAT_PAY_MCHID=
WECHAT_PAY_APPID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_API_V3_KEY=
